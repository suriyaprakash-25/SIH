{
  "name": "kmrl-metro-firebase-setup",
  "version": "1.0.0",
  "description": "Firebase setup for KMRL Metro Monitoring System",
  "scripts": {
    "setup-firebase": "node setup-firestore.js",
    "deploy-rules": "npx --yes firebase-tools@15 deploy --only firestore:rules",
    "start-emulators": "npx --yes firebase-tools@15 emulators:start",
    "login": "npx --yes firebase-tools@15 login",
    "init": "npx --yes firebase-tools@15 init"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
